{
  "name": "bakery-server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "nodemon server.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:db": "node --test --test-concurrency=1 \"tests/db/*.test.js\"",
    "test:db:setup": "node scripts/createTestDatabase.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.6.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "nodemonConfig": {
    "watch": [
      ".",
      ".env"
    ],
    "ext": "js,json",
    "ignore": [
      "node_modules/",
      "uploads/",
      "tests/"
    ]
  }
}
