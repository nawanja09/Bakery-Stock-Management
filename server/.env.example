DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
PORT=
JWT_SECRET=
# Initial password for the accountant1 login, used only when that user is first
# created. If empty, a random one is generated and printed once in the server log.
ACCOUNTANT1_PASSWORD=

# Ravon Bakers POS integration (FG Production items + Collection module)
# Source of truth for FG Items - see server/services/ravonPosService.js
RAVON_POS_API_URL=https://pos.ravonbakers.lk
RAVON_POS_ITEMS_ENDPOINT=/api/items-list
# POS authentication - automatic, server side only.
# The backend logs in to POST {RAVON_POS_API_URL}/api/login with the RAVON POS
# Finance account below (at start-up, after each Stock Management login, and
# again whenever the token expires or the POS answers 401) and uses that ONE
# session for every POS API call: /api/items-list,
# /api/completed-shifts/collection, /api/credit-payments/collection and
# /api/employee-deductions. Stock Management users log in with their own BSMS
# username / password and never need POS credentials. The password and token
# stay in server memory: never sent to the browser, never stored in the database.
# It must be the POS "finance" account that sees every branch / department.
# If the automatic login fails the API reports POS_CREDENTIALS_INVALID (RAVON POS
# rejected these credentials) or POS_AUTH_UNAVAILABLE (POS login unreachable).
# See server/services/posAuthService.js
# RAVON_POS_COLLECTION_LOOKBACK_DAYS=7   window when no date range is searched
# RAVON_POS_COMPLETION_LAG_DAYS=14       days a shift may be completed after closing
RAVON_POS_USERNAME=
RAVON_POS_PASSWORD=
# RAVON_POS_LOGIN_ENDPOINT=/api/login
# Legacy static bearer token, used only when USERNAME/PASSWORD are not set
RAVON_POS_API_KEY=
RAVON_POS_TIMEOUT_MS=8000

# Collection module (POS -> Pending). Defaults are RAVON_POS_API_URL + the paths below;
# set a full URL to override one endpoint:
# RAVON_POS_SHIFT_COLLECTION_URL=https://pos.ravonbakers.lk/api/completed-shifts/collection
# RAVON_POS_CREDIT_PAYMENTS_URL=https://pos.ravonbakers.lk/api/credit-payments/collection
# RAVON_POS_EMPLOYEE_DEDUCTIONS_URL=https://pos.ravonbakers.lk/api/employee-deductions
# Days back each Collection sync requests from the POS (default 7)
# RAVON_POS_COLLECTION_LOOKBACK_DAYS=7
# POS branch -> department, only for names the automatic rule ("Cafe - M" -> "Cafe") cannot match
# RAVON_POS_BRANCH_DEPARTMENT_MAP={"Savoury":"Savory"}
# RAVON_POS_TIMEZONE=Asia/Colombo
