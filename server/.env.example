DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
PORT=
# Both secrets are REQUIRED, must be at least 32 bytes and must differ from each
# other - the server refuses to start otherwise (config/secrets.js). Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Never commit real values: .env is git-ignored.
JWT_SECRET=
# Encrypts the stored RAVON POS / Restaurant session tokens (pos_sessions).
POS_SESSION_SECRET=


# Ravon Bakers POS + Restaurant integration (FG Production items + Collection module)
# No POS / Restaurant usernames or passwords belong here (RAVON_POS_USERNAME,
# RAVON_POS_PASSWORD, RAVON_POS_API_KEY, POS_USERNAME and POS_PASSWORD are not read).
#
# SERVER KEY MODE (recommended - the Collection page loads WITHOUT any POS /
# Restaurant login): set the PRIVATE signing key of each system. BSMS then reads
# {URL}/api/integration/..., signing every request (the key is never sent; a
# signature works once, for 5 minutes, for one URL); nobody's password is sent
# there. Who sees the Collection page = BSMS roles only; all branches.
# Generate a pair per system with:  node scripts/generateIntegrationKeys.js
# The private key goes here; the PUBLIC key in that system's .env as
# BSMS_INTEGRATION_PUBLIC_KEYS. Keep this server's clock correct (NTP).
RAVON_POS_INTEGRATION_PRIVATE_KEY=
RAVON_RESTAURANT_INTEGRATION_PRIVATE_KEY=
#
# PER-USER MODE (a key above left empty): when a user whose role has the
# Collection or FG Production page logs in to Stock Management, the same typed
# username / password are also sent once to {RAVON_POS_API_URL}/api/login and
# {RAVON_RESTAURANT_API_URL}/api/login. Only the returned token and that user's
# privileges there (abilities) are kept - server side, AES-256-GCM encrypted,
# never sent to the browser; the password is discarded. Each user's data is read
# ONLY with their own session and only for what their own POS / Restaurant
# account may see (no shared account, no API key). If a POS / Restaurant password
# differs, use Connect on the Collection page. There is NO background sync.
# See server/services/integrationAuthService.js and integrationAccess.js
RAVON_POS_API_URL=https://pos.ravonbakers.lk
# Leave empty to skip the Restaurant (reported "not configured"; POS is unaffected)
RAVON_RESTAURANT_API_URL=https://restaurant.ravonbakers.lk
# Source of truth for FG Items - see server/services/ravonPosService.js
RAVON_POS_ITEMS_ENDPOINT=/api/items-list
# RAVON_POS_LOGIN_ENDPOINT=/api/login
# RAVON_RESTAURANT_LOGIN_ENDPOINT=/api/login
RAVON_POS_TIMEOUT_MS=8000
# RAVON_RESTAURANT_TIMEOUT_MS=8000          (defaults to RAVON_POS_TIMEOUT_MS)
# Hours a POS / Restaurant session is used at most (default 24 = the BSMS login lifetime)
# RAVON_INTEGRATION_SESSION_HOURS=24

# Collection module (POS + Restaurant -> Pending). Defaults are the base URL + the
# paths below; set a full URL to override one endpoint:
# RAVON_POS_SHIFT_COLLECTION_URL=https://pos.ravonbakers.lk/api/completed-shifts/collection
# RAVON_POS_CREDIT_PAYMENTS_URL=https://pos.ravonbakers.lk/api/credit-payments/collection
# RAVON_POS_EMPLOYEE_DEDUCTIONS_URL=https://pos.ravonbakers.lk/api/employee-deductions
# RAVON_RESTAURANT_SHIFT_COLLECTION_URL=https://restaurant.ravonbakers.lk/api/completed-shifts/collection
# RAVON_RESTAURANT_CREDIT_PAYMENTS_URL=https://restaurant.ravonbakers.lk/api/credit-payments/collection
# RAVON_RESTAURANT_EMPLOYEE_DEDUCTIONS_URL=https://restaurant.ravonbakers.lk/api/employee-deductions
# Timing (used for both systems):
# RAVON_POS_COLLECTION_LOOKBACK_DAYS=7   window when no date range is searched
# RAVON_POS_COMPLETION_LAG_DAYS=14       days a shift may be completed after closing
# Branch -> department, only for names the automatic rule ("Cafe - M" -> "Cafe") cannot match
# RAVON_POS_BRANCH_DEPARTMENT_MAP={"Savoury":"Savory"}
# RAVON_POS_TIMEZONE=Asia/Colombo
